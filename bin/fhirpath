#!/usr/bin/env node

const fp = require('../src/fhirpath');
const util = require('../src/utilities');
const fs = require('fs');
const yaml = require('js-yaml');
const { Command, Option } = require('commander');
const { inspect } = require('node:util');
const { FP_Type, ResourceNode } = require('../src/types');


/**
 * Returns the inspection options for the object that a custom inspect function
 * passes to util.inspect() in place of the original value. Such a call
 * restarts the depth count in util.inspect(), so the maximum depth must be
 * replaced with the depth remaining for the original value. Otherwise, nested
 * values are printed deeper than requested, and structures with reference
 * cycles are printed endlessly. A non-numeric depth (null means unlimited
 * depth) is passed through unchanged.
 * @param {number|null} depth - the remaining depth of the inspection, or null
 *  if the depth is unlimited
 * @param {Object} options - the options for the inspection
 * @returns {Object}
 */
function getNestedInspectOptions(depth, options) {
  return typeof depth === 'number' ? {...options, depth} : options;
}


/**
 * Custom inspect function for FP_Type to provide a more readable output when
 * using console.dir or util.inspect.
 * Note that the object passed to inspectValue() is a copy of this object, so
 * util.inspect() cannot detect reference cycles that pass through an FP_Type
 * value. This is safe as long as these invariants hold:
 *  - the only reference to the evaluation context ("ctx") is replaced below;
 *  - the remaining own properties of FP_Type subclasses are created by the
 *    engine and have no back references (e.g. FP_Quantity._calendarEquivalent
 *    is one-way).
 * @param {number|null} depth - the remaining depth of the inspection, or null
 *  if the depth is unlimited
 * @param {Object} options - the options for the inspection
 * @param {Function} inspectValue - the function to inspect the value
 * @returns {string}
 */
FP_Type.prototype[inspect.custom] = function(depth, options, inspectValue) {
  // util.inspect() calls a custom inspect function even for values below the
  // requested depth, so the cutoff that util.inspect() applies to ordinary
  // objects must be reproduced here.
  if (typeof depth === 'number' && depth < 0) {
    return options.stylize('[' + this.constructor.name + ']', 'special');
  }
  const inspectedValue = {...this};
  if (inspectedValue.ctx) {
    inspectedValue.ctx = '[Context omitted]';
  }
  return this.constructor.name + ' ' +
    inspectValue(inspectedValue, getNestedInspectOptions(depth, options));
};


/**
 * Custom inspect function for ResourceNode to provide a more readable output
 * when using console.dir or util.inspect.
 * See the note about reference cycles for the FP_Type custom inspect function
 * above; for ResourceNode, the properties that could create a cycle ("ctx",
 * "model", and "parentResNode") are replaced below, and "data"/"_data" come
 * from parsed JSON, which cannot contain cycles.
 * @param {number|null} depth - the remaining depth of the inspection, or null
 *  if the depth is unlimited
 * @param {Object} options - the options for the inspection
 * @param {Function} inspectValue - the function to inspect the value
 * @returns {string}
 */
ResourceNode.prototype[inspect.custom] = function(depth, options, inspectValue) {
  // See the note about the depth cutoff for the FP_Type custom inspect
  // function above.
  if (typeof depth === 'number' && depth < 0) {
    return options.stylize('[ResourceNode]', 'special');
  }

  const inspectedValue = {
    path: this.path,
    fhirNodeDataType: this.fhirNodeDataType,
    propName: this.propName,
    index: this.index,
    data: this.data,
    _data: this._data,
    'parentResNode?.path': this.parentResNode?.path ?? null
  };
  if (this.ctx) {
    inspectedValue.ctx = '[Context omitted]';
  }
  if (this.model) {
    inspectedValue.model = '[FHIR model omitted]';
  }
  return 'ResourceNode ' +
    inspectValue(inspectedValue, getNestedInspectOptions(depth, options));
};


const program = new Command();

program
  .description('Parses and/or runs a FHIRPath expression.  If neither --resourceFile nor --resourceJSON is provided, the parse tree of the FHIRPath expression will be output.')
  .addOption(new Option('-b, --basePath <path>', 'base path in the resource from which the JSON data was extracted.'))
  .addOption(new Option('-e, --expression <expr>', 'FHIRPath expression.'))
  .addOption(new Option('-f, --resourceFile <path>', 'A file containing the JSON resource or part of it, if basePath is passed.'))
  .addOption(new Option('-r, --resourceJSON <JSON>', 'JSON resource or part of it, if basePath is passed.'))
  .addOption(new Option('-v, --variables <JSON>', 'JSON hash of variables.'))
  .addOption(new Option('-t, --terminologyUrl <url>', 'the Terminology Service API URL. Repeat the option to specify multiple servers, which are tried in order.')
    .argParser((value, previous) => (previous || []).concat(value)))
  .addOption(new Option('-s, --fhirServerUrl <url>', 'the FHIR server URL.'))
  .addOption(new Option('-m, --model <model>', 'Include FHIR model data.')
    .choices(['dstu2', 'stu3', 'r4', 'r5']))
  .addOption(new Option(`-o, --mathMode <mode>`, 'mathematical operations mode.')
    .choices(['native', 'precise']))
  .addOption(new Option('-n, --no-resolveInternalTypes',
    'disable converting values of internal types to standard JavaScript types.'))
  .parse(process.argv);

const options = program.opts();

const expression =  options.expression;
const base =  options.basePath;
if (!expression)
  program.help();
else {
  let resourceJSON = options.resourceJSON;
  if (!resourceJSON) {
    let resourceFile = options.resourceFile;
    if (resourceFile)
      resourceJSON = fs.readFileSync(resourceFile);
  }
  if (!resourceJSON) {
    // Just display the parse tree
    let res = fp.parse(expression);
    console.log('Parse tree for fhirpath(' + expression + ') =>');
    console.log(yaml.dump(res));
  }
  else {
    let context = options.variables;
    if (context)
      context = JSON.parse(context);
    let resource = JSON.parse(resourceJSON);
    let model;

    if (options.model) {
      model = require(`../fhir-context/${options.model}`);
    }
    let res = fp.evaluate(
      resource, base ? {base, expression} : expression, context, model,
      {
        async: true,
        ...(options.terminologyUrl ? {terminologyUrl: options.terminologyUrl} : {}),
        ...(options.fhirServerUrl ? {fhirServerUrl : options.fhirServerUrl} : {}),
        ...(options.mathMode ? {preciseMath : options.mathMode === 'precise'} : {}),
        ...(options.resolveInternalTypes === false ? {
          resolveInternalTypes: false
        } : {})
      }
    );

    const useCustomInspect = options.resolveInternalTypes === false;
    if (res instanceof Promise) {
      res.then((r) => printResult(expression, r, useCustomInspect))
    } else {
      printResult(expression, res, useCustomInspect);
    }
  }
}

/**
 * Prints the result to the console.
 * @param {string} expression - input expression
 * @param {Array} result - result of evaluating the expression
 * @param {boolean} useCustomInspect - whether to print internal structures
 *  using console.dir.
 */
function printResult(expression, result, useCustomInspect) {
  console.log('fhirpath(' + expression + ') =>');
  if (useCustomInspect) {
    console.dir(result, {
      depth: 4,
      colors: process.stdout.isTTY,
      customInspect: true
    });
  } else {
    console.log(util.toJSON(result, " "));
  }
}
